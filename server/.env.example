# --- Database -------------------------------------------------------------
# Hosted Postgres (Neon / Supabase). Must be Postgres: the audit-log
# immutability guarantees rely on Postgres role grants and triggers.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Role used by the running application. The audit migration REVOKEs
# UPDATE/DELETE on the audit table from this role. If you leave it unset the
# migration falls back to CURRENT_USER, which on a single-role dev database
# means the grants are a no-op - the trigger still blocks writes.
APP_DB_ROLE=""

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-32-chars-minimum-000000"
JWT_REFRESH_SECRET="change-me-different-32-chars-0000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Realtime -------------------------------------------------------------
# Optional. Without it the server uses an in-process presence registry, which
# is correct for a single instance but will NOT work across replicas.
REDIS_URL=""

PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# --- Retention ------------------------------------------------------------
LOCATION_RETENTION_DAYS="30"

# --- WebRTC (live camera / microphone) --------------------------------------
# Media travels phone <-> browser directly and is encrypted end to end by
# DTLS-SRTP. This server only helps the two peers find each other, and never
# sees the stream.
#
# STUN alone works on most home networks. TURN is the fallback for networks
# that block direct connections; it relays ciphertext it cannot read, so the
# privacy guarantee survives a relayed call.
#
# Leave TURN unset to develop on a LAN. Set it before anyone uses the app on
# mobile data or a corporate network, or roughly one call in five will fail to
# connect.
STUN_URLS=stun:stun.l.google.com:19302
# Comma-separated, e.g. turn:turn.example.org:3478,turns:turn.example.org:5349
TURN_URLS=
# Must match `static-auth-secret` in coturn's turnserver.conf. Never ships to a client.
TURN_SECRET=
TURN_TTL_SECONDS=3600
